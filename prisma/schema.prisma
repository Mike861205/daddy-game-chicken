// Prisma schema for Daddy Game Chicken
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Player {
  id        String   @id @default(uuid()) @db.Uuid
  name      String?
  nickname  String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions GameSession[]
  membership Membership?

  @@index([nickname])
  @@index([phone])
  @@map("players")
}

enum NotificationAudience {
  ALL
  INSTALLED
  BROWSER
}

enum NotificationKind {
  REMINDER
  PROMOTION
}

model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  phone     String?
  installed Boolean @default(false)
  userAgent String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
  @@index([active])
  @@index([installed])
  @@map("push_subscriptions")
}

model NotificationCampaign {
  id             String               @id @default(uuid()) @db.Uuid
  title          String
  message        String
  targetUrl      String               @default("/")
  kind           NotificationKind
  audience       NotificationAudience
  recipientCount Int                  @default(0)
  deliveredCount Int                  @default(0)
  failedCount    Int                  @default(0)
  createdAt      DateTime             @default(now())

  @@index([createdAt])
  @@map("notification_campaigns")
}

enum MembershipPlan {
  DADDY_PLUS
  DADDY_ELITE
}

enum MembershipStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

model Membership {
  id                   String           @id @default(uuid()) @db.Uuid
  playerId             String           @unique @db.Uuid
  plan                 MembershipPlan
  pendingPlan          MembershipPlan?
  status               MembershipStatus @default(INCOMPLETE)
  stripeCustomerId     String?          @unique
  stripeSubscriptionId String?          @unique
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean          @default(false)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  player          Player                     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  monthlyBenefits MembershipMonthlyBenefit[]

  @@index([status])
  @@index([plan])
  @@map("memberships")
}

model MembershipMonthlyBenefit {
  id           String   @id @default(uuid()) @db.Uuid
  membershipId String   @db.Uuid
  period       String
  code         String   @unique
  redeemedAt   DateTime?
  createdAt    DateTime @default(now())

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, period])
  @@index([code])
  @@map("membership_monthly_benefits")
}

model GameSession {
  id              String   @id @default(uuid()) @db.Uuid
  playerId        String?  @db.Uuid
  nickname        String
  score           Int
  selectedBranch  String
  durationSeconds Int
  caughtItems     Int      @default(0)
  missedItems     Int      @default(0)
  livesRemaining  Int      @default(0)
  clientSessionId String   @unique
  ipHash          String?
  createdAt       DateTime @default(now())

  player  Player?  @relation(fields: [playerId], references: [id], onDelete: SetNull)
  rewards Reward[]

  @@index([score])
  @@index([createdAt])
  @@index([playerId])
  @@index([clientSessionId])
  @@index([selectedBranch])
  @@map("game_sessions")
}

enum RewardStatus {
  AVAILABLE
  REDEEMED
  EXPIRED
}

model Reward {
  id                 String       @id @default(uuid()) @db.Uuid
  gameSessionId      String       @db.Uuid
  code               String       @unique
  label              String       @default("PROMOCIÓN DADDY POLLO")
  rewardType         String
  discountPercentage Int?
  status             RewardStatus @default(AVAILABLE)
  expiresAt          DateTime
  redeemedAt         DateTime?
  createdAt          DateTime     @default(now())

  gameSession GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([status])
  @@index([gameSessionId])
  @@map("rewards")
}

model GameConfiguration {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@index([key])
  @@map("game_configurations")
}
