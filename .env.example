# ---------------------------------------------------------------------------
# Daddy Game Chicken - Example environment variables
# Copy this file to .env and fill in the real values.
# NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# Node environment: development | production | test
NODE_ENV=development

# Port the Express API listens on
PORT=3005

# Neon PostgreSQL pooled connection string (used by the app at runtime)
DATABASE_URL=

# Neon PostgreSQL direct connection string (used by Prisma migrations)
DIRECT_URL=

# Comma separated list of allowed CORS origins
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Public URL of the game (used for WhatsApp share links)
PUBLIC_GAME_URL=http://localhost:5173

# Secret used to sign / generate reward codes. Use a long random value.
REWARD_SECRET=

# Random secret used to protect the fixed owner session cookie.
ADMIN_SESSION_SECRET=

# Super Admin credentials. Use a unique password in production.
ADMIN_USERNAME=mike
ADMIN_PASSWORD=

# Rate limiting configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Stripe Billing (add these when the two recurring Prices are created)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_DADDY_PLUS=
STRIPE_PRICE_DADDY_ELITE=
STRIPE_PAYMENT_LINK_DADDY_PLUS=https://buy.stripe.com/00w14m8bz5bPb4n8Q64c80k
STRIPE_PAYMENT_LINK_DADDY_ELITE=https://buy.stripe.com/14A28qajH8o1b4n1nE4c80j
STRIPE_PRODUCT_DADDY_PLUS=prod_Ux7hZ0O7sUc0hJ
STRIPE_PRODUCT_DADDY_ELITE=prod_Ux7iNXegfFKWbU

# Local-only deployment controls. Never enable this on the production VPS.
LOCAL_DEPLOY_ENABLED=false
DEPLOY_SSH_HOST=50.28.103.1
DEPLOY_SSH_PORT=22
DEPLOY_SSH_USER=root
DEPLOY_REMOTE_DIR=/var/www/daddy-game-chicken
DEPLOY_BRANCH=main
